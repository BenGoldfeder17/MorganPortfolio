<script>
gsap.registerPlugin(ScrollTrigger);

// ── Scroll progress bar ─────────────────────────────────────────
const progress = document.getElementById('progress');
window.addEventListener('scroll', () => {
  const pct = window.scrollY / (document.body.scrollHeight - window.innerHeight);
  progress.style.width = (pct * 100) + '%';
});

// ── Nav shadow + active link ────────────────────────────────────
const nav = document.getElementById('nav');
const navLinks = document.querySelectorAll('.nav-links a');
const sections = document.querySelectorAll('section[id]');

window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', window.scrollY > 10);
  let current = '';
  sections.forEach(s => { if (window.scrollY >= s.offsetTop - 100) current = s.id; });
  navLinks.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + current));
});

// ── Loader → hero sequence ──────────────────────────────────────
const tl = gsap.timeline();

tl.to('#loader', {
  opacity: 0, duration: 0.6, delay: 0.9, ease: 'power2.inOut',
  onComplete: () => { document.getElementById('loader').style.display = 'none'; }
})
.to('.hero-eyebrow', { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.1')
.to('.hero-name-line', {
  opacity: 1, y: 0, duration: 0.75,
  stagger: 0.15, ease: 'power3.out'
}, '-=0.3')
.to('.hero-tagline', { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.4')
.to('.hero-cta',     { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.35')
.to('.hero-right',   { opacity: 1, duration: 0.8, ease: 'power2.out' }, '-=0.6')
.to('.hero-bg-text p', { opacity: 1, x: 0, duration: 1, ease: 'power3.out' }, '-=0.5')
.to('.discipline-tag', {
  opacity: 1, x: 0, duration: 0.5,
  stagger: 0.1, ease: 'power3.out'
}, '-=0.6');

// ── Discipline tags float loop ──────────────────────────────────
document.querySelectorAll('.discipline-tag').forEach((tag, i) => {
  gsap.to(tag, {
    y: -7, duration: 2.6 + i * 0.4,
    repeat: -1, yoyo: true, ease: 'sine.inOut',
    delay: 1.8 + i * 0.2,
  });
});

// ── Work cards stagger in ───────────────────────────────────────
gsap.to('.work-card', {
  opacity: 1, duration: 0.6, stagger: 0.08, ease: 'power2.out',
  scrollTrigger: { trigger: '.work-grid', start: 'top 80%' }
});

// ── About intro ─────────────────────────────────────────────────
gsap.from('.about-intro', {
  opacity: 0, y: 32, duration: 0.7, ease: 'power3.out',
  scrollTrigger: { trigger: '.about-intro', start: 'top 82%' }
});

// ── Experience items slide in from left ─────────────────────────
gsap.from('.exp-item', {
  opacity: 0, x: -36, duration: 0.65, stagger: 0.12, ease: 'power3.out',
  scrollTrigger: { trigger: '.exp-item', start: 'top 85%' }
});

// ── Education badges pop in ─────────────────────────────────────
gsap.to('.edu-badge', {
  opacity: 1, scale: 1, duration: 0.45, stagger: 0.1,
  ease: 'back.out(1.4)',
  scrollTrigger: { trigger: '.edu-badges', start: 'top 88%' }
});

// ── Skill tags pop in ───────────────────────────────────────────
gsap.to('.skill-tag', {
  opacity: 1, scale: 1, duration: 0.4, stagger: 0.05,
  ease: 'back.out(1.6)',
  scrollTrigger: { trigger: '.skill-tags', start: 'top 88%' }
});

// ── Contact words stagger ───────────────────────────────────────
gsap.to('.contact-word', {
  opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out',
  scrollTrigger: { trigger: '.contact-headline', start: 'top 85%' }
});
gsap.to('.contact-sub',   { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out', scrollTrigger: { trigger: '.contact-sub',   start: 'top 88%' } });
gsap.to('.contact-email', { opacity: 1, duration: 0.6, ease: 'power2.out',        scrollTrigger: { trigger: '.contact-email', start: 'top 90%' } });
gsap.to('.contact-links', { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out', scrollTrigger: { trigger: '.contact-links', start: 'top 90%' } });

// ── Work filter ─────────────────────────────────────────────────
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter;
    document.querySelectorAll('.work-card').forEach(card => {
      const show = f === 'all' || card.dataset.category === f;
      gsap.to(card, { opacity: show ? 1 : 0.15, duration: 0.3, ease: 'power2.out' });
      card.style.pointerEvents = show ? 'auto' : 'none';
    });
  });
});
</script>
