<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --navy: #033047; --steel: #304C62; --slate: #5C677D;
  --grey: #D9D9D9; --cream: #F4F3EE; --white: #ffffff;
  --display: 'Cormorant Garant', Georgia, serif;
  --sans: 'Syne', sans-serif;
}
html { scroll-behavior: smooth; }
body { font-family: var(--sans); background: var(--cream); color: var(--navy); overflow-x: hidden; }

/* ── Loader ── */
#loader {
  position: fixed; inset: 0; background: var(--navy);
  display: flex; align-items: center; justify-content: center;
  z-index: 9999; flex-direction: column; gap: 1.5rem;
}
.loader-name {
  font-family: var(--display); font-style: italic; font-size: 2rem;
  font-weight: 300; color: rgba(244,243,238,0.55); letter-spacing: 0.06em;
}
.loader-track {
  width: 56px; height: 1px; background: rgba(244,243,238,0.15); overflow: hidden;
}
.loader-fill {
  height: 100%; width: 0; background: rgba(244,243,238,0.6);
  animation: lfill 0.9s ease forwards;
}
@keyframes lfill { to { width: 100%; } }

/* ── Scroll progress ── */
#progress {
  position: fixed; top: 0; left: 0; height: 2px;
  background: var(--steel); z-index: 200; width: 0;
}

/* ── Nav ── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: var(--navy); display: flex; align-items: center;
  justify-content: space-between; padding: 0 5vw; height: 64px;
  transition: box-shadow 0.4s;
}
nav.scrolled { box-shadow: 0 8px 40px rgba(3,48,71,0.5); }
.nav-wordmark {
  font-family: var(--display); font-size: 1.35rem; font-weight: 500;
  color: var(--cream); letter-spacing: 0.08em; text-decoration: none;
}
.nav-links { display: flex; gap: 2.5rem; list-style: none; }
.nav-links a {
  font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--grey); text-decoration: none;
  transition: color 0.2s; position: relative;
}
.nav-links a::after {
  content: ''; position: absolute; bottom: -4px; left: 0; right: 0;
  height: 1px; background: var(--cream); transform: scaleX(0);
  transform-origin: left; transition: transform 0.25s ease;
}
.nav-links a:hover, .nav-links a.active { color: var(--cream); }
.nav-links a:hover::after, .nav-links a.active::after { transform: scaleX(1); }

/* ── Hero ── */
#home {
  min-height: 100vh; display: grid;
  grid-template-columns: 1fr 1fr; padding-top: 64px;
}
.hero-left {
  display: flex; flex-direction: column; justify-content: center;
  padding: 8vw 4vw 8vw 8vw;
}
.hero-eyebrow {
  font-size: 0.7rem; font-weight: 600; letter-spacing: 0.22em;
  text-transform: uppercase; color: var(--slate); margin-bottom: 1.5rem;
  opacity: 0;
}
.hero-name {
  font-family: var(--display); font-size: clamp(3.5rem, 6vw, 6.5rem);
  font-weight: 300; line-height: 1.05; overflow: hidden;
}
.hero-name-line {
  display: block; opacity: 0; transform: translateY(100%);
}
.hero-name-line em { font-style: italic; color: var(--steel); }
.hero-tagline {
  margin-top: 2rem; font-size: 0.85rem; color: var(--slate);
  max-width: 320px; line-height: 1.7; opacity: 0;
}
.hero-cta { margin-top: 3rem; display: flex; gap: 1rem; flex-wrap: wrap; opacity: 0; }
.btn-primary {
  display: inline-block; padding: 0.75rem 2rem; background: var(--navy);
  color: var(--cream); font-family: var(--sans); font-size: 0.72rem;
  font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
  text-decoration: none; transition: background 0.2s;
}
.btn-primary:hover { background: var(--steel); }
.btn-ghost {
  display: inline-block; padding: 0.75rem 2rem; border: 1px solid var(--slate);
  color: var(--slate); font-family: var(--sans); font-size: 0.72rem;
  font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
  text-decoration: none; transition: border-color 0.2s, color 0.2s;
}
.btn-ghost:hover { border-color: var(--navy); color: var(--navy); }

.hero-right { background: var(--steel); position: relative; overflow: hidden; opacity: 0; }
.hero-right::before {
  content: ''; position: absolute; top: -30%; left: -20%;
  width: 80%; height: 80%; border: 1px solid rgba(244,243,238,0.1);
  border-radius: 50%; pointer-events: none;
}
.hero-right::after {
  content: ''; position: absolute; bottom: -20%; right: -20%;
  width: 60%; height: 60%; border: 1px solid rgba(244,243,238,0.06);
  border-radius: 50%; pointer-events: none;
}
.hero-disciplines {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  display: flex; flex-direction: column; gap: 0.5rem; align-items: center;
}
.discipline-tag {
  font-size: 0.68rem; font-weight: 600; letter-spacing: 0.2em;
  text-transform: uppercase; color: rgba(244,243,238,0.6);
  border: 1px solid rgba(244,243,238,0.2); padding: 0.4rem 1.2rem;
  white-space: nowrap; opacity: 0; transform: translateX(24px);
}
.hero-bg-text {
  position: absolute; bottom: 3rem; left: 3rem; right: 3rem; overflow: hidden;
}
.hero-bg-text p {
  font-family: var(--display); font-size: clamp(4rem, 8vw, 11rem);
  font-weight: 300; font-style: italic; color: rgba(244,243,238,0.07);
  line-height: 0.9; white-space: nowrap; transform: translateX(60px); opacity: 0;
}

/* ── Sections ── */
section { padding: 7rem 8vw; }
.section-label {
  font-size: 0.68rem; font-weight: 600; letter-spacing: 0.22em;
  text-transform: uppercase; color: var(--slate); margin-bottom: 1rem;
}
.section-title {
  font-family: var(--display); font-size: clamp(2.5rem, 4vw, 4rem);
  font-weight: 300; line-height: 1.1; color: var(--navy); margin-bottom: 1rem;
}
.section-title em { font-style: italic; color: var(--steel); }

/* ── Work ── */
#work { background: var(--white); }
.work-header {
  display: flex; align-items: flex-end; justify-content: space-between;
  margin-bottom: 3.5rem; flex-wrap: wrap; gap: 1rem;
}
.work-filters { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.filter-btn {
  font-family: var(--sans); font-size: 0.68rem; font-weight: 600;
  letter-spacing: 0.16em; text-transform: uppercase; padding: 0.45rem 1.1rem;
  border: 1px solid var(--grey); background: none; color: var(--slate);
  cursor: pointer; transition: all 0.2s;
}
.filter-btn:hover, .filter-btn.active {
  background: var(--navy); border-color: var(--navy); color: var(--cream);
}
.work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5px; }
.work-card {
  position: relative; overflow: hidden; cursor: pointer;
  aspect-ratio: 4/3; opacity: 0;
}
.work-card-media {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.work-card:hover .work-card-media { transform: scale(1.04); }
.card-icon { font-size: 2.5rem; opacity: 0.18; }
.work-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(3,48,71,0.92) 0%, rgba(3,48,71,0) 55%);
  opacity: 0; transition: opacity 0.35s ease;
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: 1.5rem; pointer-events: none;
}
.work-card:hover .work-overlay { opacity: 1; }
.card-category {
  font-size: 0.62rem; font-weight: 600; letter-spacing: 0.2em;
  text-transform: uppercase; color: var(--grey); margin-bottom: 0.4rem;
}
.card-title {
  font-family: var(--display); font-size: 1.3rem; font-weight: 400;
  color: var(--cream); line-height: 1.2; margin-bottom: 0.6rem;
}
.card-arrow {
  width: 28px; height: 28px; border: 1px solid rgba(244,243,238,0.4);
  display: flex; align-items: center; justify-content: center;
  color: var(--cream); font-size: 0.9rem; align-self: flex-start;
}
.work-card.hidden { display: none; }

/* ── About ── */
#about { display: block; background: var(--cream); }
.about-intro { margin-bottom: 4rem; }
.about-intro .section-title { margin-bottom: 2rem; }
.about-bio {
  color: var(--slate); line-height: 1.85; font-size: 0.95rem;
  margin-bottom: 1.2rem; max-width: 620px;
}
.about-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 5rem; align-items: start; }
.subsection-label {
  font-size: 0.62rem; font-weight: 600; letter-spacing: 0.22em;
  text-transform: uppercase; color: var(--slate); margin-bottom: 1.75rem;
  padding-bottom: 0.75rem; border-bottom: 1px solid var(--grey);
}
.exp-item {
  padding-bottom: 2rem; margin-bottom: 2rem;
  border-bottom: 1px solid var(--grey);
}
.exp-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.exp-role {
  font-family: var(--display); font-size: 1.15rem; font-weight: 500;
  color: var(--navy); margin-bottom: 0.2rem;
}
.exp-org {
  font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--steel); margin-bottom: 0.15rem;
}
.exp-date { font-size: 0.68rem; color: var(--slate); letter-spacing: 0.08em; margin-bottom: 0.85rem; }
.exp-bullets { list-style: none; }
.exp-bullets li {
  font-size: 0.83rem; color: var(--slate); line-height: 1.65;
  padding: 0.25rem 0 0.25rem 1.1rem; position: relative;
}
.exp-bullets li::before { content: '—'; position: absolute; left: 0; color: var(--grey); }
.about-sidebar > * { margin-bottom: 2.5rem; }
.edu-block { padding-bottom: 2rem; border-bottom: 1px solid var(--grey); }
.edu-school {
  font-family: var(--display); font-size: 1.15rem; font-weight: 500;
  color: var(--navy); margin-bottom: 0.4rem;
}
.edu-detail { font-size: 0.82rem; color: var(--slate); line-height: 1.75; }
.edu-badges { margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
.edu-badge {
  display: inline-block; font-size: 0.6rem; font-weight: 600; letter-spacing: 0.14em;
  text-transform: uppercase; padding: 0.3rem 0.7rem;
  background: var(--navy); color: var(--cream); opacity: 0; transform: scale(0.8);
}
.skill-group { margin-bottom: 1.25rem; }
.skill-group-label {
  font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--slate); margin-bottom: 0.5rem;
}
.skill-tags { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.4rem; }
.skill-tag {
  font-size: 0.65rem; font-weight: 600; letter-spacing: 0.12em;
  text-transform: uppercase; padding: 0.35rem 0.8rem;
  border: 1px solid var(--grey); color: var(--slate);
  transition: border-color 0.2s, color 0.2s;
  opacity: 0; transform: scale(0.8);
}
.skill-tag:hover { border-color: var(--steel); color: var(--navy); }

/* ── Contact ── */
#contact {
  background: var(--navy); display: flex; flex-direction: column;
  align-items: center; text-align: center; padding: 7rem 8vw;
}
#contact .section-label { color: rgba(217,217,217,0.5); }
.contact-headline {
  font-family: var(--display); font-size: clamp(3rem, 5vw, 5.5rem);
  font-weight: 300; color: var(--cream); line-height: 1.1;
  margin-bottom: 1.5rem; max-width: 700px;
}
.contact-headline em { font-style: italic; color: var(--grey); }
.contact-word { display: inline-block; opacity: 0; transform: translateY(24px); }
.contact-sub {
  color: var(--slate); font-size: 0.88rem; line-height: 1.7;
  max-width: 440px; margin-bottom: 2.5rem; opacity: 0;
}
.contact-email {
  font-family: var(--display); font-size: 1.3rem; font-weight: 400;
  color: var(--cream); text-decoration: none;
  border-bottom: 1px solid rgba(217,217,217,0.35);
  padding-bottom: 0.25rem; margin-bottom: 3rem; display: inline-block;
  transition: color 0.2s, border-color 0.2s; opacity: 0;
}
.contact-email:hover { color: var(--grey); border-color: var(--grey); }
.contact-links {
  display: flex; gap: 2rem; justify-content: center;
  flex-wrap: wrap; opacity: 0;
}
.contact-link {
  font-size: 0.68rem; font-weight: 600; letter-spacing: 0.2em;
  text-transform: uppercase; color: var(--slate); text-decoration: none;
  transition: color 0.2s;
}
.contact-link:hover { color: var(--cream); }

/* ── Footer ── */
footer {
  background: var(--navy); border-top: 1px solid rgba(92,103,125,0.3);
  padding: 1.5rem 8vw; display: flex; justify-content: space-between; align-items: center;
}
footer p { font-size: 0.68rem; color: rgba(92,103,125,0.7); letter-spacing: 0.08em; }

/* ── Mobile ── */
@media (max-width: 900px) {
  #home { grid-template-columns: 1fr; }
  .hero-right { min-height: 260px; }
  .about-grid { grid-template-columns: 1fr; gap: 3rem; }
  .work-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  .work-grid { grid-template-columns: 1fr; }
  .nav-links { display: none; }
}
</style>
</head>
